POSTGRES_DB=consenttrace
POSTGRES_USER=consenttrace
POSTGRES_PASSWORD=consenttrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./consenttrace.db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=consenttrace

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=development
REAL_STACK_MODE=0

